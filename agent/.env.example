# ======================================================
# Maritime Agent — contoh konfigurasi
# Salin file ini menjadi `.env` lalu sesuaikan nilainya:
#     cp .env.example .env
# File `.env` TIDAK ikut ke git (lihat .gitignore).
# ======================================================

# ── Endpoint ──────────────────────────────────────────
FRIGATE_API=http://localhost:5000/api
SERVER_API_URL=http://YOUR_SHORE_SERVER:3000/api/v1
API_KEY=your-api-key
SHIP_CODE=KP-001

# ── Kamera yang dipantau (pisahkan dengan koma) ───────
CAMERAS=kamera_depan,kamera_test

# ── Direktori (opsional — default: folder script / turunannya) ──
# AGENT_DIR=/home/nvrpc/frigate/agent
# RECORDINGS_DIR=/home/nvrpc/frigate/storage/recordings

# ── Kompresi video alert ──────────────────────────────
ALERT_VIDEO_FPS=15
ALERT_VIDEO_BITRATE=500k
ALERT_VIDEO_SCALE=640
ALERT_VIDEO_MAX_SEC=30
VAAPI_DEVICE=/dev/dri/renderD128

# ── Penyimpanan & retensi ─────────────────────────────
EVIDENCE_MAX_GB=200
EVIDENCE_TARGET_GB=150
RECORDINGS_MAX_DAYS=3

# ── Konektivitas server ───────────────────────────────
# Ganti CONNECTION_CHECK_URL ke SERVER_API_URL saat server production siap.
CONNECTION_CHECK_INTERVAL=300
CONNECTION_CHECK_URL=https://www.google.com
COMPRESS_RETRY_DELAY=180
